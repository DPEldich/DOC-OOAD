1;exitPerimeter=0;entryX=0.5;entryY=0.0;entryPerimeter=0;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="create-label" value="thêmNCC(tt)&lt;br&gt;[QLY; thông tin hợp lệ]&lt;br&gt;/ lưu nhà cung cấp mới" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;spacing=0;fontSize=16;fontColor=#303f92;align=center;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="335.0" y="158" width="470" height="71" as="geometry" /></mxCell><mxCell id="first-product" edge="1" parent="1" source="empty" target="supplying" style="edgeStyle=none;rounded=1;endArrow=open;endFill=0;strokeColor=#333333;strokeWidth=1.5;exitX=1.0;exitY=0.31666666666666665;exitPerimeter=0;entryX=0.0;entryY=0.2753623188405797;entryPerimeter=0;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="first-product-label" value="thêmSP(sp)&lt;br&gt;[QLY; liên kết hợp lệ]&lt;br&gt;/ lưu liên kết đầu tiên" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;spacing=0;fontSize=16;fontColor=#303f92;align=center;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="545.0" y="258" width="550" height="71" as="geometry" /></mxCell><mxCell id="last-product" edge="1" parent="1" source="supplying" target="empty" style="edgeStyle=none;rounded=1;endArrow=open;endFill=0;strokeColor=#333333;strokeWidth=1.5;exitX=0.0;exitY=0.782608695652174;exitPerimeter=0;entryX=1.0;entryY=0.9;entryPerimeter=0;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="last-product-label" value="bỏSP(sp)&lt;br&gt;[QLY; SP cuối; được phép bỏ]&lt;br&gt;/ xóa liên kết cuối cùng" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;spacing=0;fontSize=16;fontColor=#303f92;align=center;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="545.0" y="448" width="550" height="71" as="geometry" /></mxCell><mxCell id="deactivate" edge="1" parent="1" source="empty" target="inactive" style="edgeStyle=none;rounded=1;endArrow=open;endFill=0;strokeColor=#333333;strokeWidth=1.5;exitX=0.5;exitY=1.0;exitPerimeter=0;entryX=0.5;entryY=0.0;entryPerimeter=0;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="deactivate-label" value="xóaNCC()&lt;br&gt;[QLY; đã xác nhận; chưa có phiếu nhập]&lt;br&gt;/ vô hiệu hóa nhà cung cấp" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;spacing=0;fontSize=16;fontColor=#303f92;align=center;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="325.0" y="640" width="550" height="71" as="geometry" /></mxCell><mxCell id="finish" edge="1" parent="1" source="inactive" target="final" style="edgeStyle=none;rounded=1;endArrow=open;endFill=0;strokeColor=#333333;strokeWidth=1.5;exitX=0.5;exitY=1.0;exitPerimeter=0;entryX=0.5;entryY=0;entryPerimeter=0;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="notes" value="&lt;b&gt;Ghi chú&lt;/b&gt;&lt;br&gt;• Ký hiệu: sự kiện [điều kiện] / hành động.&lt;br&gt;• Thêm, sửa, xóa, thiết lập nguồn cung: QLY;&lt;br&gt;• tra cứu: NV hoặc QLY. Xử lý trong khung giữ trạng thái.&lt;br&gt;• Dữ liệu không hợp lệ / vi phạm ràng buộc: báo lỗi, giữ nguyên.&lt;br&gt;• Chỉ vô hiệu hóa khi không còn liên kết SP và chưa có phiếu nhập.&lt;br&gt;• SP dùng khi lập phiếu nhập phải thuộc nhà cung cấp đã chọn.&lt;br&gt;• Quy ước thiết kế: xóa logic; kết thúc vòng đời sử dụng,&lt;br&gt;• bản ghi vẫn được giữ. Không đặt luồng khôi phục chưa được quy định." style="shape=note;size=15;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#777777;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="770" y="755" width="830" height="265" as="geometry" /></mxCell><mxCell id="source" value="Nguồn nghiệp vụ: UC-NCC, SEQ-NCC, ACT-NCC và SEQ-PN.&lt;br&gt;Quy tắc ký pháp: Chương 5, trang 44-49, 52-54. Tên thuộc tính trạng thái là đề xuất phân tích." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;spacing=0;fontSize=12;fontColor=#777777;" vertex="1" parent="1"><mxGeometry x="40" y="1042" width="1600" height="34" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>