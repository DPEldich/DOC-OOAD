exitX=1.0;exitY=0.43478260869565216;exitPerimeter=0;entryX=0.0;entryY=0.43478260869565216;entryPerimeter=0;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="request-label" value="đăngNhập(tên, mk)&lt;br&gt;[đã nhập đủ thông tin]&lt;br&gt;/ gửi yêu cầu xác thực" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;spacing=0;fontSize=16;fontColor=#303f92;align=center;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="545.0" y="278" width="550" height="71" as="geometry" /></mxCell><mxCell id="invalid" edge="1" parent="1" source="checking" target="logged-out" style="edgeStyle=none;rounded=1;endArrow=open;endFill=0;strokeColor=#333333;strokeWidth=1.5;exitX=0.5;exitY=0.0;exitPerimeter=0;entryX=0.7906976744186046;entryY=0.0;entryPerimeter=0;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1355" y="150" /><mxPoint x="430" y="150" /></Array></mxGeometry></mxCell><mxCell id="invalid-label" value="[không có tài khoản hoạt động hoặc sai mật khẩu]&lt;br&gt;/ báo lỗi; yêu cầu nhập lại" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;spacing=0;fontSize=16;fontColor=#303f92;align=center;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="485.0" y="95" width="800" height="50" as="geometry" /></mxCell><mxCell id="valid" edge="1" parent="1" source="checking" target="logged-in" style="edgeStyle=none;rounded=1;endArrow=open;endFill=0;strokeColor=#333333;strokeWidth=1.5;exitX=0.5;exitY=1.0;exitPerimeter=0;entryX=0.5;entryY=0.0;entryPerimeter=0;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="valid-label" value="[tài khoản hoạt động và mật khẩu đúng]&lt;br&gt;/ tạo phiên; lưu tài khoản vào phiên;&lt;br&gt;mở trang chính" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;spacing=0;fontSize=16;fontColor=#303f92;align=center;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="760.0" y="673" width="580" height="71" as="geometry" /></mxCell><mxCell id="logout" edge="1" parent="1" source="logged-in" target="confirming" style="edgeStyle=none;rounded=1;endArrow=open;endFill=0;strokeColor=#333333;strokeWidth=1.5;exitX=0.0;exitY=0.3888888888888889;exitPerimeter=0;entryX=1.0;entryY=0.3888888888888889;entryPerimeter=0;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="logout-label" value="đăngXuất()&lt;br&gt;/ hiển thị yêu cầu xác nhận" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;spacing=0;fontSize=16;fontColor=#303f92;align=center;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="545.0" y="803" width="550" height="50" as="geometry" /></mxCell><mxCell id="confirm" edge="1" parent="1" source="confirming" target="logged-out" style="edgeStyle=none;rounded=1;endArrow=open;endFill=0;strokeColor=#333333;strokeWidth=1.5;exitX=0.5;exitY=0.0;exitPerimeter=0;entryX=0.5;entryY=1.0;entryPerimeter=0;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="confirm-label" value="đồngÝĐăngXuất()&lt;br&gt;/ xóa phiên; đóng trang chính" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;spacing=0;fontSize=16;fontColor=#303f92;align=center;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="325.0" y="553" width="550" height="50" as="geometry" /></mxCell><mxCell id="cancel" edge="1" parent="1" source="confirming" target="logged-in" style="edgeStyle=none;rounded=1;endArrow=open;endFill=0;strokeColor=#333333;strokeWidth=1.5;exitX=0.5;exitY=1.0;exitPerimeter=0;entryX=0.5;entryY=1.0;entryPerimeter=0;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="305" y="1050" /><mxPoint x="1355" y="1050" /></Array></mxGeometry></mxCell><mxCell id="cancel-label" value="hủyĐăngXuất()&lt;br&gt;/ giữ nguyên phiên; tiếp tục làm việc" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;spacing=0;fontSize=16;fontColor=#303f92;align=center;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="485.0" y="993" width="670" height="50" as="geometry" /></mxCell><mxCell id="notes" value="&lt;b&gt;Ghi chú&lt;/b&gt;&lt;br&gt;• Ký hiệu: sự kiện [điều kiện] / hành động. Nhánh không ghi sự kiện ở AUTHENTICATING là chuyển khi kiểm tra hoàn tất.&lt;br&gt;• Hai điều kiện xác thực loại trừ nhau: có tài khoản hoạt động + mật khẩu đúng, hoặc điều kiện đó không thỏa.&lt;br&gt;• Đăng xuất xóa phiên rồi trở về NOT_AUTHENTICATED; hủy đăng xuất giữ nguyên phiên.&lt;br&gt;• Không vẽ nút kết thúc: ngữ cảnh xác thực còn có thể đăng nhập lại; đăng xuất không xóa hoặc khóa tài khoản." style="shape=note;size=15;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#777777;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="60" y="1120" width="1560" height="150" as="geometry" /></mxCell><mxCell id="source" value="Nguồn nghiệp vụ: UC-XT, SEQ đăng nhập, SEQ đăng xuất và ACT-XT.&lt;br&gt;Quy tắc ký pháp: Chương 5, trang 44-49, 52-54. Tên thuộc tính trạng thái là đề xuất phân tích." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;spacing=0;fontSize=12;fontColor=#777777;" vertex="1" parent="1"><mxGeometry x="40" y="1282" width="1600" height="34" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>