<mxfile host="app.diagrams.net" version="26.0.0"><diagram id="state-KH" name="Khách hàng"><mxGraphModel dx="1480" dy="860" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1480" pageHeight="860" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="&lt;b&gt;Sơ đồ trạng thái - Khách hàng&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;spacing=0;fontSize=27;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1400" height="34" as="geometry" /></mxCell><mxCell id="subtitle" value="Đối tượng: một hồ sơ khách hàng | Góc nhìn: tình trạng lưu hồ sơ | Người thao tác: NV" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;spacing=0;fontSize=16;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1400" height="28" as="geometry" /></mxCell><mxCell id="draft" value="" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#222222;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="80" y="250" width="440" height="255" as="geometry" /></mxCell><mxCell id="draft-header" value="&lt;b&gt;DRAFT&lt;/b&gt;&lt;br&gt;&lt;i&gt;Chưa lưu hồ sơ&lt;/i&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;spacing=0;fontSize=17;align=center;" vertex="1" parent="draft"><mxGeometry x="12" y="12" width="416" height="50" as="geometry" /></mxCell><mxCell id="draft-attribute" value="customerState = DRAFT" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;spacing=0;fontSize=15;fontColor=#666666;" vertex="1" parent="draft"><mxGeometry x="14" y="75" width="412" height="25" as="geometry" /></mxCell><mxCell id="draft-actions"