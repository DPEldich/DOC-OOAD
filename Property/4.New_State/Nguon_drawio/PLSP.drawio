mp;gt; 0&lt;br&gt;gánSP(sp) [liên kết hợp lệ]&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;/ lưu thêm liên kết phân loại&lt;br&gt;bỏSP(sp) [còn SP khác; hợp lệ]&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;/ gỡ liên kết được chọn&lt;br&gt;cậpNhật(tt) [hợp lệ] / lưu thông tin&lt;br&gt;xóaPhânLoại() / từ chối: còn sản phẩm" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;spacing=0;fontSize=16;lineHeight=21;" vertex="1" parent="in-use"><mxGeometry x="14" y="112" width="442" height="223" as="geometry" /></mxCell><mxCell id="in-use-separator0" style="endArrow=none;startArrow=none;strokeColor=#9a7979;strokeWidth=1;html=1;" edge="1" parent="in-use"><mxGeometry relative="1" as="geometry"><mxPoint x="14" y="65" as="sourcePoint" /><mxPoint x="456" y="65" as="targetPoint" /></mxGeometry></mxCell><mxCell id="in-use-separator1" style="endArrow=none;startArrow=none;strokeColor=#9a7979;strokeWidth=1;html=1;" edge="1" parent="in-use"><mxGeometry relative="1" as="geometry"><mxPoint x="14" y="102" as="sourcePoint" /><mxPoint x="456" y="102" as="targetPoint" /></mxGeometry></mxCell><mxCell id="inactive" value="" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#222222;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="90" y="800" width="430" height="170" as="geometry" /></mxCell><mxCell id="inactive-header" value="&lt;b&gt;INACTIVE&lt;/b&gt;&lt;br&gt;&lt;i&gt;Ngừng sử dụng&lt;/i&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;spacing=0;fontSize=17;align=center;" vertex="1" parent="inactive"><mxGeometry x="12" y="12" width="406" height="50" as="geometry" /></mxCell><mxCell id="inactive-attribute" value="categoryState = INACTIVE" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;spacing=0;fontSize=15;fontColor=#666666;" vertex="1" parent="inactive"><mxGeometry x="14" y="75" width="402" height="25" as="geometry" /></mxCell><mxCell id="inactive-actions" value="entry / giữ bản ghi để lưu vết&lt;br&gt;Không gán cho sản phẩm mới" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;spacing=0;fontSize=16;lineHeight=21;" vertex="1" parent="inactive"><mxGeometry x="14" y="112" width="402" height="48" as="geometry" /></mxCell><mxCell id="inactive-separator0" style="endArrow=none;startArrow=none;strokeColor=#9a7979;strokeWidth=1;html=1;" edge="1" parent="inactive"><mxGeometry relative="1" as="geometry"><mxPoint x="14" y="65" as="sourcePoint" /><mxPoint x="416" y="65" as="targetPoint" /></mxGeometry></mxCell><mxCell id="inactive-separator1" style="endArrow=none;startArrow=none;strokeColor=#9a7979;strokeWidth=1;html=1;" edge="1" parent="inactive"><mxGeometry relative="1" as="geometry"><mxPoint x="14" y="102" as="sourcePoint" /><mxPoint x="416" y="102" as="targetPoint" /></mxGeometry></mxCell><mxCell id="initial" value="" style="ellipse;html=1;fillColor=#222222;strokeColor=#222222;" vertex="1" parent="1"><mxGeometry x="294" y="119" width="22" height="22" as="geometry" /></mxCell><mxCell id="final" value="" style="ellipse;html=1;fillColor=#ffffff;strokeColor=#222222;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="290" y="995" width="30" height="30" as="geometry" /></mxCell><mxCell id="final-dot" value="" style="ellipse;html=1;fillColor=#222222;strokeColor=#222222;" vertex="1" parent="1"><mxGeometry x="296" y="1001" width="18" height="18" as="geometry" /></mxCell><mxCell id="create" edge="1" parent="1" source="initial" target="unused" style="edgeStyle=none;rounded=1;endArrow=open;endFill=0;strokeColor=#333333;strokeWidth=1.5;exitX=0.5;exitY=1;exitPerimeter=0;entryX=0.5;entryY=0.0;entryPerimeter=0;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="create-label" value="thêmPhânLoại(tt)&lt;br&gt;[QLY; thông tin hợp lệ]&lt;br&gt;/ lưu phân loại mới" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;spacing=0;fontSize=16;fontColor=#303f92;align=center;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="335.0" y="158" width="470" height="71" as="geometry" /></mxCell><mxCell id="first-product" edge="1" parent="1" source="unused" target="in-use" style="edgeStyle=none;rounded=1;endArrow=open;endFill=0;strokeColor=#333333;strokeWidth=1.5;exitX=1.0;exitY=0.3392857142857143;exitPerimeter=0;entryX=0.0;entryY=0.2753623188405797;entryPerimeter=0;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="first-product-label" value="gánSP(sp)&lt;br&gt;[liên kết hợp lệ]&lt;br&gt;/ gán sản phẩm đầu tiên" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;spacing=0;fontSize=16;fontColor=#303f92;align=center;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="545.0" y="258" width="550" height="71" as="geometry" /></mxCell><mxCell id="last-product" edge="1" parent="1" source="in-use" target="unused" style="edgeStyle=none;rounded=1;endArrow=open;endFill=0;strokeColor=#333333;strokeWidth=1.5;exitX=0.0;exitY=0.7246376811594203;exitPerimeter=0;entryX=1.0;entryY=0.8928571428571429;entryPerimeter=0;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="last-product-label" value="bỏSP(sp)&lt;br&gt;[SP cuối; liên kết được gỡ hợp lệ]&lt;br&gt;/ gỡ liên kết sản phẩm cuối cùng" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;spacing=0;fontSize=16;fontColor=#303f92;align=center;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="545.0" y="418" width="550" height="71" as="geometry" /></mxCell><mxCell id="deactivate" edge="1" parent="1" source="unused" target="inactive" style="edgeStyle=none;rounded=1;endArrow=open;endFill=0;strokeColor=#333333;strokeWidth=1.5;exitX=0.5;exitY=1.0;exitPerimeter=0;entryX=0.5;entryY=0.0;entryPerimeter=0;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="deactivate-label" value="xóaPhânLoại()&lt;br&gt;[QLY; đã xác nhận; không có sản phẩm]&lt;br&gt;/ vô hiệu hóa phân loại" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;spacing=0;fontSize=16;fontColor=#303f92;align=center;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="325.0" y="631" width="550" height="71" as="geometry" /></mxCell><mxCell id="finish" edge="1" parent="1" source="inactive" target="final" style="edgeStyle=none;rounded=1;endArrow=open;endFill=0;strokeColor=#333333;strokeWidth=1.5;exitX=0.5;exitY=1.0;exitPerimeter=0;entryX=0.5;entryY=0;entryPerimeter=0;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="notes" value="&lt;b&gt;Ghi chú&lt;/b&gt;&lt;br&gt;• Ký hiệu: sự kiện [điều kiện] / hành động.&lt;br&gt;• Thêm, sửa, xóa phân loại: QLY; tra cứu: NV hoặc QLY.&lt;br&gt;• Xử lý trong khung không làm đổi trạng thái.&lt;br&gt;• Dữ liệu không hợp lệ / vi phạm ràng buộc: báo lỗi, giữ nguyên.&lt;br&gt;• Gán hoặc bỏ sản phẩm là biến cố từ phân hệ Sản phẩm;&lt;br&gt;• thực hiện theo quyền và ràng buộc của phân hệ đó.&lt;br&gt;• Quy ước thiết kế: xóa logic; chỉ kết thúc vòng đời sử dụng,&lt;br&gt;• bản ghi vẫn được giữ. Không xóa khi còn sản phẩm liên kết." style="shape=note;size=15;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#777777;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="770" y="755" width="830" height="265" as="geometry" /></mxCell><mxCell id="source" value="Nguồn nghiệp vụ: UC-PLSP, SEQ-PLSP, ACT-PLSP; thay đổi liên kết từ phân hệ Sản phẩm.&lt;br&gt;Quy tắc ký pháp: Chương 5, trang 44-49, 52-54. Tên thuộc tính trạng thái là đề xuất phân tích." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;spacing=0;fontSize=12;fontColor=#777777;" vertex="1" parent="1"><mxGeometry x="40" y="1042" width="1600" height="34" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>