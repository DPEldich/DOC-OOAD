<mxfile host="app.diagrams.net" version="26.0.0"><diagram id="state-PLSP" name="Phân loại sản phẩm"><mxGraphModel dx="1680" dy="1080" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1680" pageHeight="1080" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="&lt;b&gt;Sơ đồ trạng thái - Phân loại sản phẩm&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;spacing=0;fontSize=27;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1600" height="34" as="geometry" /></mxCell><mxCell id="subtitle" value="Đối tượng: một phân loại sản phẩm | Góc nhìn: tình trạng sử dụng của phân loại" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;spacing=0;fontSize=16;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1600" height="28" as="geometry" /></mxCell><mxCell id="unused" value="" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#222222;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="90" y="250" width="430" height="280" as="geometry" /></mxCell><mxCell id="unused-header" value="&lt;b&gt;UNUSED&lt;/b&gt;&lt;br&gt;&lt;i&gt;Chưa có sản phẩm&lt;/i&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;spacing=0;fontSize=17;align=center;" vertex="1" parent="unused"><mxGeometry x="12" y="12" width="406" height="50" as="geometry" /></mxCell><mxCell id="unused-attribute" value="categoryState = UNUSED" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;spacing=0;fontSize=15;fontColor=#666666;" vertex="1" parent="unused"><mxGeometry x="14" y="75" width="402" height="25" as="geometry" /></mxCell><mxC